<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AITrans.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="AITrans.Views.SubtitlesView"
             x:DataType="vm:SubtitlesViewModel">

  <DockPanel Margin="10">
    <!-- Top Controls -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
      <Button x:Name="OpenFileBtn" Content="📂 Open SRT" Click="OnOpenFileClick" />
      <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage}" Width="150" />
      <ComboBox ItemsSource="{Binding AvailableTranslationProviders}" SelectedItem="{Binding TranslationProviderMode}"
                Width="110" ToolTip.Tip="Доставчик за превод" />
      <TextBlock Text="Реплики/заявка:" VerticalAlignment="Center"
                 ToolTip.Tip="Брой субтитри, изпращани заедно в една заявка при локален доставчик (Ollama/LM Studio). По-голяма стойност дава повече контекст за кратки реплики." />
      <NumericUpDown Value="{Binding LocalBatchSize}" Minimum="1" Maximum="20" Increment="1" Width="120"
                     ToolTip.Tip="Брой субтитри, изпращани заедно в една заявка при локален доставчик (Ollama/LM Studio). По-голяма стойност дава повече контекст за кратки реплики." />
      <Button Content="▶ Translate All" Command="{Binding TranslateCommand}" />
      <Button Content="▶ Selected" Command="{Binding TranslateSelectedCommand}" ToolTip.Tip="Translate only selected rows" />
      <Button Content="▶ From Here" Command="{Binding TranslateFromSelectedCommand}" ToolTip.Tip="Translate from selected row to end" />
      <Button Content="⏹ Cancel" Command="{Binding CancelTranslationCommand}" IsVisible="{Binding IsTranslating}" />
      <Button x:Name="SaveFileBtn" Content="💾 Save" Click="OnSaveFileClick" />
      <Separator Width="1" Background="Gray" VerticalAlignment="Stretch" Margin="4,0" />
      <Button Content="🗄 Cache" Command="{Binding SaveCacheCommand}" ToolTip.Tip="Save current translation session to database" />
      <Button Content="♫ Restore" x:Name="RestoreBtn" Click="OnRestoreCacheClick" IsEnabled="{Binding HasCache}" ToolTip.Tip="Izberi kesh sesiq za vръщане" />
      <ProgressBar IsVisible="{Binding IsTranslating}" Value="{Binding Progress}" Maximum="100" Width="200" MinHeight="20" />
    </StackPanel>

    <!-- File path indicator -->
    <TextBlock DockPanel.Dock="Top" Text="{Binding LoadedFilePath}" Margin="0,0,0,2" FontSize="12" Opacity="0.6"
               IsVisible="{Binding LoadedFilePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <!-- Cache info -->
    <TextBlock DockPanel.Dock="Top" Text="{Binding CacheInfo}" Margin="0,0,0,5" FontSize="11" Opacity="0.8"
               IsVisible="{Binding HasCache}" />

    <!-- Status bar -->
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Margin="0,5,0,0" Opacity="0.7" TextWrapping="Wrap" />

    <!-- Subtitle entries (DataGrid) -->
    <DataGrid x:Name="SubtitleGrid"
              x:CompileBindings="False"
              ItemsSource="{Binding Entries}"
              AutoGenerateColumns="False"
              CanUserReorderColumns="False"
              CanUserResizeColumns="True"
              GridLinesVisibility="Horizontal"
              SelectionMode="Extended"
              PointerPressed="OnSubtitleGridPointerPressed"
              IsReadOnly="False">
      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="➕ Вмъкни ред отдолу" Command="{Binding InsertRowBelowCommand}" />
          <MenuItem Header="Delete selected row" Command="{Binding DeleteSelectedCommand}" />
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50" IsReadOnly="True" />
        <DataGridTextColumn Header="Time" Binding="{Binding TimeCode}" Width="180" IsReadOnly="True" />
        <DataGridTemplateColumn Header="Original" Width="*" MinWidth="120">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Border Background="Transparent">
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="📋 Копирай оригинал" Click="OnCopyOriginalClick" />
                    <Separator />
                    <MenuItem Header="➕ Вмъкни ред отдолу" Click="OnInsertRowBelowClick" />
                    <MenuItem Header="🗑 Изтрий избраните редове" Click="OnDeleteSelectedClick" />
                  </ContextMenu>
                </Border.ContextMenu>
                <TextBox Text="{Binding DisplayOriginalText}" TextWrapping="Wrap" Padding="4"
                         IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         IsHitTestVisible="False" />
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
          <DataGridTemplateColumn.CellEditingTemplate>
            <DataTemplate>
              <TextBox Text="{Binding OriginalText}" TextWrapping="Wrap" AcceptsReturn="True" />
            </DataTemplate>
          </DataGridTemplateColumn.CellEditingTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Translation" Width="*" MinWidth="120">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Border Background="Transparent">
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="📋 Копирай превод" Click="OnCopyTranslationClick" />
                    <Separator />
                    <MenuItem Header="➕ Вмъкни ред отдолу" Click="OnInsertRowBelowClick" />
                    <MenuItem Header="🗑 Изтрий избраните редове" Click="OnDeleteSelectedClick" />
                  </ContextMenu>
                </Border.ContextMenu>
                <TextBox Text="{Binding DisplayTranslatedText}" TextWrapping="Wrap" Padding="4"
                         IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         IsHitTestVisible="False" />
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
          <DataGridTemplateColumn.CellEditingTemplate>
            <DataTemplate>
              <TextBox Text="{Binding TranslatedText}" TextWrapping="Wrap" AcceptsReturn="True" />
            </DataTemplate>
          </DataGridTemplateColumn.CellEditingTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
