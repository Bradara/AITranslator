<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AITrans.ViewModels"
             xmlns:models="using:AITrans.Models"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="AITrans.Views.FlashcardsView"
             x:DataType="vm:FlashcardsViewModel">

  <DockPanel Margin="10">

    <!-- ══ TOP: Add card form ═══════════════════════════════════════════════ -->
    <Border DockPanel.Dock="Top" Padding="0,0,0,8" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Spacing="6">

        <!-- Row 1: three text inputs -->
        <Grid ColumnDefinitions="*,*,*">
          <TextBox Grid.Column="0" Watermark="Страна 1 – дума / израз"
                   Text="{Binding NewFrontText}" Margin="0,0,5,0"
                   AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="120" />
          <TextBox Grid.Column="1" Watermark="Страна 2 – превод (BG)"
                   Text="{Binding NewBackText}" Margin="0,0,5,0"
                   AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="120" />
          <TextBox Grid.Column="2" Watermark="Страна 3 – употреба / тезаурус"
                   Text="{Binding NewUsageText}"
                   AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="120" />
        </Grid>

        <!-- Row 2: action buttons -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="✦ Генерирай с AI"
                  Command="{Binding GenerateWithAiCommand}"
                  IsEnabled="{Binding !IsGeneratingAi}"
                  ToolTip.Tip="{Binding AiModelLabel}" />
          <TextBlock Text="{Binding AiModelLabel}"
                     VerticalAlignment="Center" FontSize="11" Opacity="0.55"
                     IsVisible="{Binding !IsGeneratingAi}" />
          <Button Content="+ Добави карта"
                  Command="{Binding AddCardCommand}" />
          <Button x:Name="ImportCsvBtn"
                  Content="📥 Импорт CSV"
                  Click="OnImportCsvClick"
                  ToolTip.Tip="Импортирай от CSV (разделител ;): front;back;usage" />
          <Button Content="📋 Всички карти"
                  Click="OnShowAllCardsClick"
                  ToolTip.Tip="Отвори списъка с всички карти за преглед и редакция" />
          <TextBlock Text="{Binding StatusText}"
                     VerticalAlignment="Center" Opacity="0.7" FontSize="12"
                     IsVisible="{Binding StatusText,
                         Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ══ TTS toolbar ═══════════════════════════════════════════════════════ -->
    <Border DockPanel.Dock="Bottom" Padding="0,5,0,0" BorderThickness="0,1,0,0"
            Margin="0,0,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="TTS:" VerticalAlignment="Center" FontSize="12" Opacity="0.65" />
        <!-- Front-side language -->
        <TextBlock Text="Чужд:" VerticalAlignment="Center" FontSize="12" />
        <ComboBox ItemsSource="{Binding AvailableLanguages}"
                  SelectedItem="{Binding FrontLanguage}"
                  Width="120" />
        <!-- Back-side language -->
        <TextBlock Text="BG/превод:" VerticalAlignment="Center" FontSize="12" />
        <ComboBox ItemsSource="{Binding AvailableLanguages}"
                  SelectedItem="{Binding BackLanguage}"
                  Width="120" />
        <Separator Width="1" Background="Gray" VerticalAlignment="Stretch" Margin="4,2" />
        <!-- Speak current side -->
        <Button Content="🔊 Изговори"
                Command="{Binding SpeakCurrentSideCommand}"
                IsEnabled="{Binding !IsSpeaking}"
                ToolTip.Tip="Изговори текущата страна на картата" />
        <!-- Auto-play -->
        <Button Content="▶▶ Авто"
                Command="{Binding StartAutoPlayCommand}"
                IsEnabled="{Binding !IsAutoPlaying}"
                ToolTip.Tip="Автоматично обръщане на всички страни с TTS и преминаване към следваща карта" />
        <!-- Stop -->
        <Button Content="⏹ Стоп"
                Command="{Binding StopSpeechCommand}"
                IsVisible="{Binding IsSpeaking}"
                ToolTip.Tip="Спри изговарянето" />
        <Button Content="⏹ Стоп авто"
                Command="{Binding StopSpeechCommand}"
                IsVisible="{Binding IsAutoPlaying}"
                ToolTip.Tip="Спри автоматичното изговаряне" />
      </StackPanel>
    </Border>

    <!-- ══ BOTTOM: Mode selector ═══════════════════════════════════════════ -->
    <Border DockPanel.Dock="Bottom" Padding="0,6,0,0" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="Режим:" VerticalAlignment="Center" />
        <RadioButton Content="🔄 Обръщане"
                     IsChecked="{Binding IsFlipMode}"
                     GroupName="FlashcardMode"
                     ToolTip.Tip="Преглед — кликни върху картата, за да видиш следващата страна" />
        <RadioButton Content="✏️ Въвеждане"
                     IsChecked="{Binding IsForeignToNativeMode}"
                     GroupName="FlashcardMode"
                     ToolTip.Tip="Виждаш думата, въвеждаш превода" />
        <RadioButton Content="☑ Избор"
                     IsChecked="{Binding IsMultipleChoiceMode}"
                     GroupName="FlashcardMode"
                     ToolTip.Tip="Виждаш думата на чуждия език, избираш превода от 4 варианта" />
        <RadioButton Content="🔊 Слушане"
                     IsChecked="{Binding IsListenMode}"
                     GroupName="FlashcardMode"
                     ToolTip.Tip="Чуваш думата, въвеждаш превода" />
        <RadioButton Content="🔊☑ Слушане+Избор"
                     IsChecked="{Binding IsListenChoiceMode}"
                     GroupName="FlashcardMode"
                     ToolTip.Tip="Чуваш думата, избираш превода от 4 варианта" />
        <Separator Width="1" Background="Gray" VerticalAlignment="Stretch" Margin="0,4" />
        <CheckBox Content="🔄 BG → Чужд"
                  IsChecked="{Binding ReverseQuizDirection}"
                  ToolTip.Tip="Обърни посоката: чуваш/виждаш BG превода, въвеждаш думата на чуждия език"
                  VerticalAlignment="Center" />
        <Button Content="🔀 Разбъркай"
                Command="{Binding ShuffleCommand}"
                ToolTip.Tip="Разбъркай реда на картите" />
      </StackPanel>
    </Border>

    <!-- ══ MAIN: Card display area ══════════════════════════════════════════ -->
    <Grid RowDefinitions="Auto,*">

      <!-- Counter row -->
      <StackPanel Grid.Row="0" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="12" Margin="0,6,0,4">
        <TextBlock Text="{Binding CardPositionText}"
                   IsVisible="{Binding HasCards}"
                   FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock IsVisible="{Binding HasCards}"
                   VerticalAlignment="Center" FontSize="13" Opacity="0.55">
          <TextBlock.Text>
            <MultiBinding StringFormat="(✅ заучени: {0})">
              <Binding Path="LearnedCount" />
            </MultiBinding>
          </TextBlock.Text>
        </TextBlock>
      </StackPanel>

      <!-- Card + side-nav buttons -->
      <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">

        <!-- Left arrow -->
        <Button Grid.Column="0"
                Content="&#x276E;"
                FontSize="36"
                Command="{Binding PreviousCardCommand}"
                IsEnabled="{Binding HasCards}"
                VerticalAlignment="Center"
                Background="Transparent" BorderThickness="0"
                Padding="12,8"
                ToolTip.Tip="Предишна карта" />

        <!-- Inner card grid -->
        <Grid Grid.Column="1">

      <!-- Empty state -->
      <TextBlock IsVisible="{Binding !HasCards}"
                 Text="Няма карти. Добавете карта с формата горе или импортирайте CSV."
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Opacity="0.5" FontSize="16" TextAlignment="Center" />

      <!-- ── Mode 1: Flip card ── -->
      <Border IsVisible="{Binding ShowFlipCard}"
              CornerRadius="12" Padding="40"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
              BorderThickness="1"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              MinWidth="500" MinHeight="280">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
          <!-- Clickable card face -->
          <Button Command="{Binding AdvanceSideCommand}"
                  Background="Transparent" BorderThickness="0"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  ToolTip.Tip="Кликни, за да видиш следващата страна">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
              <TextBlock Text="{Binding CurrentSideLabel}"
                         FontSize="13" Opacity="0.55"
                         HorizontalAlignment="Center" />
              <TextBlock Text="{Binding CurrentSideText}"
                         FontSize="26" FontWeight="SemiBold"
                         TextWrapping="Wrap" MaxWidth="440"
                         HorizontalAlignment="Center" TextAlignment="Center" />
              <TextBlock Text="↻ кликни за обръщане"
                         FontSize="11" Opacity="0.4"
                         HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
          </Button>
          <!-- Rating buttons — visible after at least one flip -->
          <StackPanel IsVisible="{Binding ShowFlipRating}"
                      Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,4,0,0">
            <TextBlock Text="Оцени:" VerticalAlignment="Center" Opacity="0.65" FontSize="13" />
            <Button Content="💪 Трудна"  Command="{Binding RateHardCommand}"    ToolTip.Tip="Показва се с висок приоритет" />
            <Button Content="😐 Нормална" Command="{Binding RateNormalCommand}"  ToolTip.Tip="Показва се с нормален приоритет" />
            <Button Content="😊 Лесна"   Command="{Binding RateEasyCommand}"    ToolTip.Tip="Показва се с нисък приоритет" />
            <Button Content="✅ Заучена" Command="{Binding RateLearnedCommand}" ToolTip.Tip="Изключва картата от тестовете" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ── Modes 2 & 3: Quiz ── -->
      <Border IsVisible="{Binding ShowQuizCard}"
              CornerRadius="12" Padding="40"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
              BorderThickness="1"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              MinWidth="520" MinHeight="320">
        <StackPanel Spacing="20" HorizontalAlignment="Center">

          <!-- Prompt -->
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <TextBlock Text="Какъв е преводът на български?"
                       IsVisible="{Binding !ReverseQuizDirection}"
                       FontSize="13" Opacity="0.55" HorizontalAlignment="Center" />
            <TextBlock Text="Какъв е преводът на чуждия език?"
                       IsVisible="{Binding ReverseQuizDirection}"
                       FontSize="13" Opacity="0.55" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding QuizPromptText}"
                       FontSize="30" FontWeight="Bold"
                       TextWrapping="Wrap" MaxWidth="440"
                       HorizontalAlignment="Center" TextAlignment="Center" />
          </StackPanel>

          <!-- Answer input (before submit) -->
          <StackPanel IsVisible="{Binding !IsAnswerSubmitted}"
                      Spacing="10" HorizontalAlignment="Center">
            <TextBox x:Name="AnswerBox"
                     Text="{Binding UserAnswer}"
                     Watermark="Въведете превода…"
                     Width="340" FontSize="16"
                     KeyDown="OnAnswerBoxKeyDown" />
            <Button Content="✔ Провери отговора"
                    Command="{Binding SubmitAnswerCommand}"
                    HorizontalAlignment="Center" />
          </StackPanel>

          <!-- Feedback (after submit) - quiz card -->
          <StackPanel IsVisible="{Binding IsAnswerSubmitted}"
                      Spacing="12" HorizontalAlignment="Center">
            <TextBlock Text="{Binding AnswerFeedback}"
                       FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="440"
                       Classes.correct="{Binding IsAnswerCorrect}">
              <TextBlock.Styles>
                <Style Selector="TextBlock.correct">
                  <Setter Property="Foreground" Value="#2ECC71" />
                </Style>
              </TextBlock.Styles>
            </TextBlock>
            <!-- Rating buttons replace "next card" in quiz mode -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,4,0,0">
              <TextBlock Text="Оцени:" VerticalAlignment="Center" Opacity="0.65" FontSize="13" />
              <Button Content="💪 Трудна"  Command="{Binding RateHardCommand}"    ToolTip.Tip="Показва се с висок приоритет" />
              <Button Content="😐 Нормална" Command="{Binding RateNormalCommand}"  ToolTip.Tip="Показва се с нормален приоритет" />
              <Button Content="😊 Лесна"   Command="{Binding RateEasyCommand}"    ToolTip.Tip="Показва се с нисък приоритет" />
              <Button Content="✅ Заучена" Command="{Binding RateLearnedCommand}" ToolTip.Tip="Изключва картата от тестовете" />
            </StackPanel>
          </StackPanel>

        </StackPanel>
      </Border>

      <!-- ── Mode 4: Multiple-choice ── -->
      <Border IsVisible="{Binding ShowMultipleChoice}"
              CornerRadius="12" Padding="40"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
              BorderThickness="1"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              MinWidth="520">
        <StackPanel Spacing="20" HorizontalAlignment="Center">

          <!-- Question -->
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <TextBlock Text="Какъв е преводът на български?"
                       IsVisible="{Binding !ReverseQuizDirection}"
                       FontSize="13" Opacity="0.55" HorizontalAlignment="Center" />
            <TextBlock Text="Какъв е преводът на чуждия език?"
                       IsVisible="{Binding ReverseQuizDirection}"
                       FontSize="13" Opacity="0.55" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding QuizPromptText}"
                       FontSize="30" FontWeight="Bold"
                       TextWrapping="Wrap" MaxWidth="440"
                       HorizontalAlignment="Center" TextAlignment="Center" />
          </StackPanel>

          <!-- 4 choice buttons -->
          <ItemsControl ItemsSource="{Binding Choices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:ChoiceOption">
                <Button HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,4"
                        MinWidth="340"
                        FontSize="16"
                        Command="{Binding $parent[UserControl].((vm:FlashcardsViewModel)DataContext).SelectChoiceCommand}"
                        CommandParameter="{Binding}"
                        Content="{Binding Text}"
                        Classes.correct="{Binding IsCorrectState}"
                        Classes.wrong="{Binding IsWrongState}">
                  <Button.Styles>
                    <Style Selector="Button.correct">
                      <Setter Property="Background" Value="#2ECC71" />
                      <Setter Property="Foreground" Value="White" />
                    </Style>
                    <Style Selector="Button.wrong">
                      <Setter Property="Background" Value="#E74C3C" />
                      <Setter Property="Foreground" Value="White" />
                    </Style>
                  </Button.Styles>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Rating buttons shown after answering MC -->
          <StackPanel IsVisible="{Binding IsMcAnswerSubmitted}"
                      Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,4,0,0">
            <TextBlock Text="Оцени:" VerticalAlignment="Center" Opacity="0.65" FontSize="13" />
            <Button Content="💪 Трудна"  Command="{Binding RateHardCommand}"    ToolTip.Tip="Показва се с висок приоритет" />
            <Button Content="😐 Нормална" Command="{Binding RateNormalCommand}"  ToolTip.Tip="Показва се с нормален приоритет" />
            <Button Content="😊 Лесна"   Command="{Binding RateEasyCommand}"    ToolTip.Tip="Показва се с нисък приоритет" />
            <Button Content="✅ Заучена" Command="{Binding RateLearnedCommand}" ToolTip.Tip="Изключва картата от тестовете" />
          </StackPanel>

        </StackPanel>
      </Border>

      <!-- ── Mode 4: Listen ── -->
      <Border IsVisible="{Binding ShowListenCard}"
              CornerRadius="12" Padding="40"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
              BorderThickness="1"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              MinWidth="520" MinHeight="320">
        <StackPanel Spacing="20" HorizontalAlignment="Center">

          <!-- Prompt icon — click to replay -->          <StackPanel Spacing="8" HorizontalAlignment="Center">
            <Button Command="{Binding SpeakListenPromptCommand}"
                    Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Center"
                    Cursor="Hand"
                    ToolTip.Tip="Кликни за повторно произнасяне">
              <TextBlock Text="🔊" FontSize="48" />
            </Button>
            <TextBlock Text="Какъв е преводът на български?"
                       IsVisible="{Binding !ReverseQuizDirection}"
                       FontSize="13" Opacity="0.55" HorizontalAlignment="Center" />
            <TextBlock Text="Какъв е преводът на чуждия език?"
                       IsVisible="{Binding ReverseQuizDirection}"
                       FontSize="13" Opacity="0.55" HorizontalAlignment="Center" />
          </StackPanel>

          <!-- Answer input (before submit) -->
          <StackPanel IsVisible="{Binding !IsAnswerSubmitted}"
                      Spacing="10" HorizontalAlignment="Center">
            <TextBox Text="{Binding UserAnswer}"
                     Watermark="Въведете превода…"
                     Width="340" FontSize="16"
                     KeyDown="OnAnswerBoxKeyDown" />
            <Button Content="✔ Провери отговора"
                    Command="{Binding SubmitAnswerCommand}"
                    HorizontalAlignment="Center" />
          </StackPanel>

          <!-- Feedback (after submit) - listen card -->
          <StackPanel IsVisible="{Binding IsAnswerSubmitted}"
                      Spacing="12" HorizontalAlignment="Center">
            <TextBlock Text="{Binding AnswerFeedback}"
                       FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="440"
                       Classes.correct="{Binding IsAnswerCorrect}">
              <TextBlock.Styles>
                <Style Selector="TextBlock.correct">
                  <Setter Property="Foreground" Value="#2ECC71" />
                </Style>
              </TextBlock.Styles>
            </TextBlock>
            <!-- Rating buttons replace "next card" in listen mode -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,4,0,0">
              <TextBlock Text="Оцени:" VerticalAlignment="Center" Opacity="0.65" FontSize="13" />
              <Button Content="💪 Трудна"  Command="{Binding RateHardCommand}"    ToolTip.Tip="Показва се с висок приоритет" />
              <Button Content="😐 Нормална" Command="{Binding RateNormalCommand}"  ToolTip.Tip="Показва се с нормален приоритет" />
              <Button Content="😊 Лесна"   Command="{Binding RateEasyCommand}"    ToolTip.Tip="Показва се с нисък приоритет" />
              <Button Content="✅ Заучена" Command="{Binding RateLearnedCommand}" ToolTip.Tip="Изключва картата от тестовете" />
            </StackPanel>
          </StackPanel>

        </StackPanel>
      </Border>

      <!-- ── Mode 5: Listen + Choice ── -->
      <Border IsVisible="{Binding ShowListenChoice}"
              CornerRadius="12" Padding="40"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
              BorderThickness="1"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              MinWidth="520">
        <StackPanel Spacing="20" HorizontalAlignment="Center">

          <!-- Clickable speaker icon -->
          <StackPanel Spacing="8" HorizontalAlignment="Center">
            <Button Command="{Binding SpeakListenPromptCommand}"
                    Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Center"
                    Cursor="Hand"
                    ToolTip.Tip="Кликни за повторно произнасяне">
              <TextBlock Text="🔊" FontSize="48" />
            </Button>
            <TextBlock Text="Какъв е преводът на български?"
                       IsVisible="{Binding !ReverseQuizDirection}"
                       FontSize="13" Opacity="0.55" HorizontalAlignment="Center" />
            <TextBlock Text="Какъв е преводът на чуждия език?"
                       IsVisible="{Binding ReverseQuizDirection}"
                       FontSize="13" Opacity="0.55" HorizontalAlignment="Center" />
          </StackPanel>

          <!-- 4 choice buttons -->
          <ItemsControl ItemsSource="{Binding Choices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:ChoiceOption">
                <Button HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,4"
                        MinWidth="340"
                        FontSize="16"
                        Command="{Binding $parent[UserControl].((vm:FlashcardsViewModel)DataContext).SelectChoiceCommand}"
                        CommandParameter="{Binding}"
                        Content="{Binding Text}"
                        Classes.correct="{Binding IsCorrectState}"
                        Classes.wrong="{Binding IsWrongState}">
                  <Button.Styles>
                    <Style Selector="Button.correct">
                      <Setter Property="Background" Value="#2ECC71" />
                      <Setter Property="Foreground" Value="White" />
                    </Style>
                    <Style Selector="Button.wrong">
                      <Setter Property="Background" Value="#E74C3C" />
                      <Setter Property="Foreground" Value="White" />
                    </Style>
                  </Button.Styles>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Rating buttons shown after answering ListenChoice -->
          <StackPanel IsVisible="{Binding IsMcAnswerSubmitted}"
                      Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,4,0,0">
            <TextBlock Text="Оцени:" VerticalAlignment="Center" Opacity="0.65" FontSize="13" />
            <Button Content="💪 Трудна"  Command="{Binding RateHardCommand}"    ToolTip.Tip="Показва се с висок приоритет" />
            <Button Content="😐 Нормална" Command="{Binding RateNormalCommand}"  ToolTip.Tip="Показва се с нормален приоритет" />
            <Button Content="😊 Лесна"   Command="{Binding RateEasyCommand}"    ToolTip.Tip="Показва се с нисък приоритет" />
            <Button Content="✅ Заучена" Command="{Binding RateLearnedCommand}" ToolTip.Tip="Изключва картата от тестовете" />
          </StackPanel>

        </StackPanel>
      </Border>

        </Grid><!-- end inner card grid -->

        <!-- Right arrow -->
        <Button Grid.Column="2"
                Content="&#x276F;"
                FontSize="36"
                Command="{Binding NextCardCommand}"
                IsEnabled="{Binding HasCards}"
                VerticalAlignment="Center"
                Background="Transparent" BorderThickness="0"
                Padding="12,8"
                ToolTip.Tip="Следваща карта" />

      </Grid><!-- end card + side-nav -->
    </Grid><!-- end main area -->

  </DockPanel>
</UserControl>
