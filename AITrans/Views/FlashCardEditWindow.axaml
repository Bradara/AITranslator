<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AITrans.Views.FlashCardEditWindow"
        x:CompileBindings="False"
        Title="Всички флаш карти — редакция"
        Width="820" Height="560"
        MinWidth="600" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

  <DockPanel Margin="14">

    <!-- Header -->
    <TextBlock DockPanel.Dock="Top"
               Text="Редактирай или изтрий карти. Промените се запазват при затваряне на реда."
               FontSize="13" Opacity="0.65" Margin="0,0,0,10" />

    <!-- Bottom buttons -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
      <Button Content="Затвори" Click="OnCloseClick" />
    </StackPanel>

    <!-- DataGrid -->
    <DataGrid x:Name="CardsGrid"
              x:CompileBindings="False"
              AutoGenerateColumns="False"
              CanUserReorderColumns="False"
              CanUserResizeColumns="True"
              GridLinesVisibility="Horizontal"
              IsReadOnly="False"
              CellEditEnding="OnCellEditEnding">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Страна 1 — дума / израз"
                            Binding="{Binding FrontText}" Width="*" />
        <DataGridTextColumn Header="Страна 2 — превод (BG)"
                            Binding="{Binding BackText}" Width="*" />
        <DataGridTextColumn Header="Страна 3 — употреба"
                            Binding="{Binding UsageText}" Width="*" />
        <DataGridTextColumn Header="✓" Binding="{Binding CorrectCount}" Width="40" IsReadOnly="True" />
        <DataGridTextColumn Header="✗" Binding="{Binding WrongCount}"   Width="40" IsReadOnly="True" />
        <DataGridTemplateColumn Header="" Width="50">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Content="🗑" Padding="4,2"
                      Click="OnDeleteClick"
                      ToolTip.Tip="Изтрий картата" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

  </DockPanel>
</Window>
