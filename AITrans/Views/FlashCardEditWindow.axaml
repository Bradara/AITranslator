<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AITrans.Views"
        xmlns:models="using:AITrans.Models"
        x:Class="AITrans.Views.FlashCardEditWindow"
        x:CompileBindings="False"
        Title="Всички флаш карти — редакция"
        Width="820" Height="560"
        MinWidth="600" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

  <DockPanel Margin="14">

    <!-- Header -->
    <TextBlock DockPanel.Dock="Top"
               Text="Редактирай или изтрий карти. Промените се запазват при затваряне на реда."
               FontSize="13" Opacity="0.65" Margin="0,0,0,6" />

    <!-- Search bar -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <TextBox x:Name="SearchBox" Grid.Column="0"
               Watermark="🔍 Търсене по дума, превод или употреба…"
               TextChanged="OnSearchTextChanged" />
      <Button Grid.Column="1" Content="✕" Margin="6,0,0,0"
              ToolTip.Tip="Изчисти търсенето"
              Click="OnClearSearchClick" />
    </Grid>

    <!-- Bottom buttons -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
      <Button Content="Затвори" Click="OnCloseClick" />
    </StackPanel>

    <!-- DataGrid -->
    <DataGrid x:Name="CardsGrid"
              x:CompileBindings="False"
              AutoGenerateColumns="False"
              CanUserReorderColumns="False"
              CanUserResizeColumns="True"
              CanUserSortColumns="True"
              GridLinesVisibility="Horizontal"
              IsReadOnly="False"
              RowHeight="72"
              Sorting="OnColumnSorting"
              CellEditEnding="OnCellEditEnding">
      <DataGrid.Columns>
        <!-- Страна 1 -->
        <DataGridTemplateColumn Header="Страна 1 — дума / израз" Width="*" SortMemberPath="FrontText" CanUserSort="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding FrontText}" TextWrapping="Wrap"
                         VerticalAlignment="Center" Margin="8,4" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
          <DataGridTemplateColumn.CellEditingTemplate>
            <DataTemplate>
              <TextBox Text="{Binding FrontText, Mode=TwoWay}"
                       AcceptsReturn="False" TextWrapping="Wrap"
                       KeyDown="OnCellKeyDown"
                       VerticalAlignment="Stretch" />
            </DataTemplate>
          </DataGridTemplateColumn.CellEditingTemplate>
        </DataGridTemplateColumn>
        <!-- Страна 2 -->
        <DataGridTemplateColumn Header="Страна 2 — превод (BG)" Width="*" SortMemberPath="BackText" CanUserSort="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding BackText}" TextWrapping="Wrap"
                         VerticalAlignment="Center" Margin="8,4" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
          <DataGridTemplateColumn.CellEditingTemplate>
            <DataTemplate>
              <TextBox Text="{Binding BackText, Mode=TwoWay}"
                       AcceptsReturn="False" TextWrapping="Wrap"
                       KeyDown="OnCellKeyDown"
                       VerticalAlignment="Stretch" />
            </DataTemplate>
          </DataGridTemplateColumn.CellEditingTemplate>
        </DataGridTemplateColumn>
        <!-- Страна 3 -->
        <DataGridTemplateColumn Header="Страна 3 — употреба" Width="*" SortMemberPath="UsageText" CanUserSort="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding UsageText}" TextWrapping="Wrap"
                         VerticalAlignment="Center" Margin="8,4" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
          <DataGridTemplateColumn.CellEditingTemplate>
            <DataTemplate>
              <TextBox Text="{Binding UsageText, Mode=TwoWay}"
                       AcceptsReturn="False" TextWrapping="Wrap"
                       KeyDown="OnCellKeyDown"
                       VerticalAlignment="Stretch" />
            </DataTemplate>
          </DataGridTemplateColumn.CellEditingTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="✓" Binding="{Binding CorrectCount}" Width="40" IsReadOnly="True" CanUserSort="True" SortMemberPath="CorrectCount" />
        <DataGridTextColumn Header="✗" Binding="{Binding WrongCount}"   Width="40" IsReadOnly="True" CanUserSort="True" SortMemberPath="WrongCount" />
        <!-- Rating column — editable so Learned cards can be reset -->
        <DataGridTemplateColumn Header="Рейтинг" Width="130" SortMemberPath="Rating" CanUserSort="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Rating}" VerticalAlignment="Center" Margin="8,0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
          <DataGridTemplateColumn.CellEditingTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{x:Static local:FlashCardEditWindow.RatingValues}"
                        SelectedItem="{Binding Rating, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" />
            </DataTemplate>
          </DataGridTemplateColumn.CellEditingTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="" Width="50">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Content="🗑" Padding="4,2"
                      Click="OnDeleteClick"
                      ToolTip.Tip="Изтрий картата" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

  </DockPanel>
</Window>
